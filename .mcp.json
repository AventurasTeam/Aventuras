{
  "mcpServers": {
    "electron-app": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@0.0.82",
        "--cdp-endpoint",
        "http://127.0.0.1:${AVENTURAS_DEVTOOLS_PORT:-9222}"
      ]
    },
    "storybook-mcp": {
      "url": "http://localhost:${AVENTURAS_STORYBOOK_PORT:-6006}/mcp",
      "type": "http"
    }
  }
}
