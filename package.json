{
  "name": "aventura",
  "version": "0.7.12",
  "description": "AI-powered adventure and creative writing frontend",
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "tauri": "tauri",
    "test": "vitest run",
    "test:watch": "vitest",
    "release": "node scripts/release.js",
    "fake-provider": "node scripts/fake-provider.mjs",
    "lint": "node scripts/pm.js run lint:ts && node scripts/pm.js run lint:rust",
    "lint:fix": "node scripts/pm.js run lint:ts:fix && node scripts/pm.js run lint:rust:fix",
    "lint:ts": "eslint .",
    "lint:ts:fix": "eslint . --fix",
    "lint:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml --check && cargo +1.100.0 clippy --manifest-path src-tauri/Cargo.toml --all-targets --all-features -- -D warnings",
    "lint:rust:fix": "cargo +1.100.0 clippy --manifest-path src-tauri/Cargo.toml --all-targets --all-features --fix --allow-dirty -- -D warnings && cargo fmt --manifest-path src-tauri/Cargo.toml",
    "format": "prettier --write \"**/*.{ts,js,svelte,json,css,html}\""
  },
  "license": "AGPL-3.0",
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.105",
    "@ai-sdk/deepseek": "^3.0.87",
    "@ai-sdk/google": "^4.0.121",
    "@ai-sdk/groq": "^4.0.84",
    "@ai-sdk/mistral": "^4.0.87",
    "@ai-sdk/openai": "^4.0.118",
    "@ai-sdk/openai-compatible": "^3.0.92",
    "@ai-sdk/xai": "^5.0.46",
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/lang-liquid": "^6.3.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@lucide/svelte": "^1.73.0",
    "@openrouter/ai-sdk-provider": "^3.1.0",
    "@tauri-apps/api": "^2.12.5",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-fs": "^2.7.1",
    "@tauri-apps/plugin-http": "^2.9.0",
    "@tauri-apps/plugin-notification": "^2.8.1",
    "@tauri-apps/plugin-opener": "^2.7.3",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-sql": "^2.6.0",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "@tutorlatin/svelte-tiny-virtual-list": "^4.0.0",
    "ai": "^7.0.173",
    "ai-sdk-pollinations": "^0.0.2",
    "clsx": "^2.1.1",
    "codemirror": "^6.0.2",
    "gpt-tokenizer": "^4.1.2",
    "harper.js": "^2.13.0",
    "html5-qrcode": "^2.3.8",
    "jsonrepair": "^3.15.0",
    "liquidjs": "^10.30.1",
    "marked": "^18.2.1",
    "svelte-codemirror-editor": "^2.1.0",
    "tailwind-merge": "^3.7.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@ai-sdk/provider": "^4.0.38",
    "@sveltejs/adapter-static": "^4.0.1",
    "@sveltejs/kit": "^3.2.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.5",
    "@tauri-apps/cli": "^2.12.5",
    "@types/json-schema": "^7.0.15",
    "@types/node": "^24",
    "bits-ui": "^2.21.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.4.4",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-svelte": "^3.24.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "lefthook": "^2.2.2",
    "prettier": "^3.10.1",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "tailwind-variants": "^3.3.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vaul-svelte": "^1.0.0-next.7",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "runed": {
      "@sveltejs/kit": "$@sveltejs/kit"
    }
  },
  "aube": {
    "allowBuilds": {
      "esbuild": true,
      "lefthook": true,
      "unrs-resolver": true
    }
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.15.0",
      "onFail": "error"
    }
  },
  "allowScripts": {
    "lefthook@2.2.2": true,
    "unrs-resolver@1.12.2": true
  }
}
