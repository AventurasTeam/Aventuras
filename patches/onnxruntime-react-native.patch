+++ b/react-native.config.js
@@ -0,0 +1,15 @@
+// PoC patch: ORT-RN ships no autolinking config, so RN's PackageList
+// generator skips it and NativeModules.Onnxruntime ends up null at
+// runtime ("Cannot read property 'install' of null"). This config
+// teaches RN autolinking how to register the legacy ReactPackage.
+module.exports = {
+  dependency: {
+    platforms: {
+      android: {
+        sourceDir: './android',
+        packageImportPath: 'import ai.onnxruntime.reactnative.OnnxruntimePackage;',
+        packageInstance: 'new OnnxruntimePackage()',
+      },
+    },
+  },
+}
