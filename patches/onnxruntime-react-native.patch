@@ -244,13 +244,14 @@ dependencies {
   if (useQnn) {
     extractLibs "com.microsoft.onnxruntime:onnxruntime-android-qnn:latest.integration@aar"
   } else {
-    extractLibs "com.microsoft.onnxruntime:onnxruntime-android:latest.integration@aar"
+    // Pinned, not latest.integration, so a clean build ships the tested runtime. CMakeLists.txt
+    // names the same version: its glob would take the first of every version ever extracted.
+    extractLibs "com.microsoft.onnxruntime:onnxruntime-android:1.31.0@aar"
   }
 
-  if (VersionNumber.parse(REACT_NATIVE_VERSION) < VersionNumber.parse("0.71")) {
-    extractLibs "com.facebook.fbjni:fbjni:+:headers"
-    extractLibs "com.facebook.fbjni:fbjni:+"
-  }
+  // Gradle 9 removed VersionNumber, which this guard calls. The guard only
+  // gated an fbjni fallback for RN < 0.71 and this app runs 0.83, so the branch
+  // is dead — dropping it is the minimal change that builds under Gradle 9.
 
   // By default it will just include onnxruntime full aar package
   if (ortExtensionsEnabled) {
diff --git a/react-native.config.js b/react-native.config.js
new file mode 100644
--- /dev/null
+++ b/react-native.config.js
@@ -0,0 +1,15 @@
+// Upstream ships no autolinking config, so RN's PackageList generator skips
+// this package and NativeModules.Onnxruntime is null at runtime ("Cannot read
+// property 'install' of null"). This is the standard dependency config that
+// teaches autolinking to register the legacy ReactPackage.
+module.exports = {
+  dependency: {
+    platforms: {
+      android: {
+        sourceDir: './android',
+        packageImportPath: 'import ai.onnxruntime.reactnative.OnnxruntimePackage;',
+        packageInstance: 'new OnnxruntimePackage()',
+      },
+    },
+  },
+}
